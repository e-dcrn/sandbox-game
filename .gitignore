# ----------------------------------------------------------------------
# Build Directories (Lieux où CMake génère les binaires)
# ----------------------------------------------------------------------
build/
out/
bin/
lib/

# ----------------------------------------------------------------------
# C++ Compilation Artifacts (Fichiers objets et exécutables)
# ----------------------------------------------------------------------
*.obj
*.o
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.exp
*.pdb
*.ilk

# ----------------------------------------------------------------------
# CMake generated files (Si jamais tu génères à la racine par erreur)
# ----------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.ninja
*.cbp

# ----------------------------------------------------------------------
# IDE & Editors (Fichiers de configuration locaux qu'on ne partage pas)
# ----------------------------------------------------------------------
# Visual Studio Code
.vscode/

# Visual Studio (Windows)
.vs/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters

# CLion (JetBrains)
.idea/

# XCode (Mac)
*.xcodeproj/
*.xcworkspace/

# ----------------------------------------------------------------------
# OS System Files
# ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------
# Dépendances Externes (Optionnel)
# ----------------------------------------------------------------------
# Si tu télécharges des librairies lourdes (ex: GLFW compilé),
# tu peux vouloir ignorer le dossier vendor, mais pour GLAD/GLM
# je te conseille de les garder dans le git pour l'instant.
# vendor/
